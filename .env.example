# Earthquake Classifier Environment Configuration
# To use Neon or Supabase Cloud PostgreSQL, paste your connection string below:
# Example Neon: postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Example Supabase: postgresql://postgres:password@db.supabase.co:5432/postgres?sslmode=require

DATABASE_URL=sqlite:///./earthquakes.db

# Default USGS API Feed (options: all_day, all_week, all_month, 2.5_month)
USGS_FEED=all_week
